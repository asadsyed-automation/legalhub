# Server Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legalhub
DB_SSL=false

# Optional separate test database (if omitted, tests run against DATABASE_URL using @test.legalhub.local emails)
TEST_DATABASE_URL=

# Authentication & Security
# Must be at least 32 characters long
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long_min
JWT_EXPIRES_IN=2h

# CORS - Comma-separated list of allowed frontend origins
FRONTEND_URLS=http://localhost:3000,http://localhost:5173

# Admin Seeding (Used by scripts/seedAdmin.js)
ADMIN_EMAIL=admin@legalhub.pk
ADMIN_PASSWORD=AdminSecurePassword123!
